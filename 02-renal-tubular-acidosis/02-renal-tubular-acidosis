			<p>Usually &gt;15mEq/L</p>
			</td>
		</tr>
		<tr>
			<td style="width:155px;">
			<p>Clinical features</p>
			</td>
			<td style="width:154px;">
			<p>Nephrolithiasis</p>
			</td>
			<td style="width:154px;">
			<p>Small stature, osteodystrophy</p>
			</td>
			<td style="width:154px;">
			<p>Variable; most commonly DM2, SCA</p>
			</td>
		</tr>
