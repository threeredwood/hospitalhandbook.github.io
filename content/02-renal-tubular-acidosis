		</tr>
		<tr>
			<td style="width:158px;height:1px;">
			<p>Defect</p>
			</td>
			<td style="width:158px;height:1px;">
			<p>Impaired distal H+ secretion or inability to lower urine pH</p>
			</td>
			<td style="width:158px;height:1px;">
			<p>Diminished HCO3 resorption</p>
			</td>
			<td style="width:157px;height:1px;">
			<p>Aldosterone deficiency/resistance</p>
			</td>
		</tr>
		<tr>
			<td style="width:158px;">
			<p>Urine pH</p>
			</td>
			<td style="width:158px;">
			<p>&gt; 5.3</p>
			</td>
			<td style="width:158px;">
			<p>Variable (depending on HCO3 resorptive threshold and bicarbonate supplementation)</p>
			</td>
			<td style="width:157px;">
			<p>Usually &lt; 5.3</p>
			</td>
		</tr>
		<tr>
			<td style="width:158px;">
			<p>Plasma K+</p>
			</td>
			<td style="width:158px;">
			<p>Low or normal</p>
			</td>
			<td style="width:158px;">
			<p>Low or normal</p>
			</td>
			<td style="width:157px;">
			<p>High</p>
			</td>
		</tr>
		<tr>
			<td style="width:158px;height:0px;">
			<p>Plasma HCO3</p>
			</td>
			<td style="width:158px;height:0px;">
			<p>Very low (may be &lt; 10 mEq/L)</p>
			</td>
			<td style="width:158px;height:0px;">
			<p>Moderately low (12-20 mEq/L)</p>
			</td>
			<td style="width:157px;height:0px;">
			<p>Usually &gt;15 mEq/L</p>
			</td>
		</tr>
		<tr>
			<td style="width:158px;height:0px;">
			<p>Clinical features</p>
			</td>
			<td style="width:158px;height:0px;">
			<p>Nephrolithiasis, nephrocalcinosis</p>
			</td>
			<td style="width:158px;height:0px;">
			<p>Small stature, osteodystrophy/osteomalacia</p>
			</td>
			<td style="width:157px;height:0px;">
			<p>Variable; most commonly associated with DM2</p>
			</td>
		</tr>
	</tbody>
</table>

